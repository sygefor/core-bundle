<html>
<head>
    <link href="{{ app.request.getSchemeAndHttpHost() ~ asset('assets/styles/pdf.css') }}" rel="stylesheet" type="text/css" />
    {% block head %}{% endblock %}
</head>
<body class="organization-{{ organization.code }} pdf">
    <div class="row">
        <div class="col-xs-2">
            <!-- Used to hold an image, keep columns to not mess with the layout -->
        </div>
        <div class="col-xs-10">
            <strong>{{ organization.name }}</strong><br>
            {{ organization.fullAddress|nl2br }}
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            {% block body %}{% endblock %}
        </div>
    </div>
</body>
